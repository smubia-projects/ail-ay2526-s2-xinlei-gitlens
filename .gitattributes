# Ensure binary files are treated correctly by Git
* text=auto

*.png binary delta=false
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.css text
*.js text
*.ts text
*.tsx text
*.html text
*.json text
*.md text

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text