# ---------------------------------------------------------------------------
# GitLens AI Code Visualizer — backend environment
# Copy to .env for local dev. In production these are set on Cloud Run via the
# repo's DOTENV secret (gh secret set DOTENV < .env) — see DOCS/ailodge/cicd.md.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres + pgvector) ---
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Neon requires TLS — keep ?sslmode=require.
# Embeddings live in vector(768) columns in this same database; the schema
# bootstrap runs CREATE EXTENSION IF NOT EXISTS vector (supported on Neon).
DATABASE_URL=

# --- AI inference ---
# Server-side chat fallback (used when a user hasn't configured their own key).
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model ids)
# OPENROUTER_FLASH_MODEL=google/gemini-2.5-flash
# OPENROUTER_PRO_MODEL=google/gemini-2.5-pro

# Embeddings fallback — Gemini direct (OpenRouter does not serve embeddings).
GEMINI_API_KEY=

# --- GitHub OAuth (required for private repo access) ---
# The OAuth app's callback URL must be: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_NAME=

# --- Auth / sessions ---
# Required in production. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# --- Deployment ---
# Public URL of this backend (the Cloud Run service URL). Used to build the
# GitHub OAuth redirect URI.
APP_URL=
# Comma-separated allowed frontend origins, e.g. https://gitlens.vercel.app
# Leave empty in local dev to allow all origins.
CORS_ORIGINS=

# --- Rate limiting (shared engine; Upstash Redis) ---
# If unset, rate limiting is silently disabled (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback limits when the central config sheet is unreachable.
# chat = /api/ai/proxy, embed = /api/ai/embed (indexing makes many embed calls).
RATE_LIMIT_CHAT_MAX=5
RATE_LIMIT_EMBED_MAX=300
RATE_LIMIT_WINDOW_SECONDS=432000
